# Copy these values to the local .env file. Never commit that file.

# Hosted dashboard access (required when APP_ENV=production)
APP_ENV=development
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Free market data provider
TWELVE_DATA_API_KEY=
TWELVE_DATA_BASE_URL=https://api.twelvedata.com
MARKET_DATA_TIMEOUT_SECONDS=15
MARKET_DATA_MAX_RETRIES=2
MARKET_DATA_REQUESTS_PER_MINUTE=8

# Optional Telegram alerts: set BOTH values, or leave both empty
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_SECONDS=10
TELEGRAM_MAX_RETRIES=2
DASHBOARD_URL=

# Optional app state persistence (server-side key only)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy service-role JWT is accepted if using an older project key:
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TIMEOUT_SECONDS=10
SIGNAL_RETENTION_DAYS=30
